      "markingGuide": [
        {
          "step": 1,
          "description": "P(both red)=(3/5)(2/4)=3/10."
        },
        {
          "step": 2,
          "description": "P(red then blue)=(3/5)(2/4)=3/10."
        },
        {
          "step": 3,
          "description": "P(blue then red)=(2/5)(3/4)=3/10."
        },
        {
          "step": 4,
          "description": "P(one of each)=3/10+3/10=3/5."
        }
      ],
