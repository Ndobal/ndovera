      "prompt": "A rectangular garden has length 5 m greater than its width and area 84 m². Form a quadratic equation and calculate its dimensions.",
      "answer": "Width 7 m; length 12 m",
      "markingGuide": [
        {
          "step": 1,
          "description": "Let width=x, length=x+5."
        },
        {
          "step": 2,
          "description": "x(x+5)=84, so x²+5x−84=0."
        },
        {
          "step": 3,
          "description": "Factor (x+12)(x−7)=0; width must be positive, so x=7."
        }
      ],
