      "topic": "Coordinate geometry",
      "type": "structured",
      "prompt": "Find the equation of the line passing through (1,2) and (5,10), then calculate its x-intercept.",
      "answer": "y=2x; x-intercept (0,0)",
      "markingGuide": [
        {
          "step": 1,
          "description": "Gradient=(10−2)/(5−1)=2."
        },
        {
          "step": 2,
          "description": "Using point-slope form: y−2=2(x−1), hence y=2x."
        },
        {
          "step": 3,
          "description": "At the x-intercept y=0, giving x=0."
        }
      ],
